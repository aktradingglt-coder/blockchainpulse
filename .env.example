# Names only — never put real values in this file or any committed file (PROMPT §1.5, §19).
# Local development: `make dev` generates a git-ignored .env with random local credentials.

# --- Core ------------------------------------------------------------------
APP_ENV=                      # dev | test | staging | production
APP_BASE_URL=                 # public URL of the web app
API_BASE_URL=                 # public URL of the API
DEPLOYMENT_MODE=              # hosted | self_hosted (drives licence gates)
CONFIG_DIR=                   # directory holding config/*.yaml (default: repo config/)
DATABASE_URL=                 # postgresql+asyncpg://user:password@host:5432/db
REDIS_URL=                    # redis://:password@host:6379/0 (Valkey)
LOG_LEVEL=                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=                   # json | console
SERVICE_NAME=                 # rd-api | rd-worker | rd-scheduler
CORS_ALLOWED_ORIGINS=         # comma-separated origins

# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Data sources ----------------------------------------------------------
SEC_EDGAR_USER_AGENT=         # "Company Name contact@domain" (SEC fair-access requirement)
FRED_API_KEY=
EIA_API_KEY=
TWELVEDATA_API_KEY=           # commercial vendor (provider_twelvedata flag); other vendors follow <VENDOR>_API_KEY

# --- Billing ---------------------------------------------------------------
BILLING_PROVIDER=             # paddle | lemonsqueezy
BILLING_API_KEY=
BILLING_WEBHOOK_SECRET=

# --- Delivery --------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=

# --- Auth and licensing ----------------------------------------------------
AUTH_SECRET=
# AUTH_PROVIDER_KEYS ...      # OAuth client IDs/secrets, one variable per provider
LICENCE_SIGNING_PRIVATE_KEY=  # hosted licence issuer only, from the secret manager

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
FEATURE_FLAGS=                # JSON object of booleans, e.g. {"provider_fred": false}

# --- Local stack only (generated by scripts/dev_env.sh) ---------------------
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
