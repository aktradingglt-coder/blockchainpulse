{
  "name": "@research-desk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "tokens": "node scripts/gen-tokens.mjs",
    "predev": "node scripts/gen-tokens.mjs",
    "dev": "next dev --port 3000",
    "prebuild": "node scripts/gen-tokens.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "node scripts/gen-tokens.mjs && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
